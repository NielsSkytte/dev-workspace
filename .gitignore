# Project subfolders are their own git repositories — not tracked by the workspace repo
/customers/
/own/

# Shared Pingala repos mounted here (psi-context-library) — own repos, never tracked by dev-workspace
/pingala/

# Archived .git dirs from repos folded into their customer repo (preserved history, recoverable)
/_git-archive/

# Per-turn capture hook state (harness runtime, not portable substrate)
.claude/hooks/.capture_state.json
.claude/hooks/.track_time_state.json
.claude/hooks/.daybrief_state.json
__pycache__/

# This repo HAS a remote (github.com/NielsSkytte/dev-workspace) — so unlike the local-only
# unit repos under /customers/ and /own/, it must never carry credentials or bulk data.
.secrets/
data/

# Time-tracking DATA is operational output, regenerable from heartbeats — not versioned.
# (The system itself — ops/time/README.md + rollup.py — stays tracked.)
/ops/time/heartbeats/
/ops/time/timesheet/
/ops/time/value/
# Line descriptions: what each day's work WAS, written at /log. Operational output
# like the rest, regenerable from ops/memory/daily/ -- and this repo has a remote, so
# customer work descriptions do not belong in it. The robocopy mirror at /log covers
# the whole of ops/time, so it is backed up with everything else.
/ops/time/lines/
# The not-invoiced register: decisions, not derived data, so it is the one file here
# that cannot be regenerated -- the robocopy mirror at /log is its backup, and it stays
# out of a repo with a remote because it names customers and what was not billed to them.
/ops/time/not-invoiced.md
# What each F&O task id is called -- a register too, filled in as the ids are met.
/ops/time/fno-tasks.md
# Which line each session's time was split onto. Named customers and sessions, and the
# page rebuilds nothing from it that the timesheet does not already hold.
/ops/time/session-lines.md
# Which project a moved line's measurement follows to. Names customers and sessions.
/ops/time/measure-moves.md
/ops/time/active-task
/ops/time/fno-journals.md
