// Its presence hides the .vscode/tasks.json tasks from Zed's task picker (Zed skips
// .vscode tasks when a .zed/tasks.json has at least one valid task). Agent tasks live in
// %APPDATA%\Zed\tasks.json, generated by ops/bin/zed-tasks.py.
[
  {
    "label": "Terminal (C:/Dev)",
    "command": "powershell",
    "args": ["-NoLogo"],
    "cwd": "C:/Dev",
    "use_new_terminal": true,
    "reveal_target": "center"
  }
]
